# Create your API key from:  https://trello.com/power-ups/admin/
# To generate TRELLO_API_TOKEN go here:  https://trello.com/1/authorize?expiration=never&name=<you-app-name>&scope=read,write&response_type=token&key=<your_api_key>
TRELLO_API_KEY=your_trello_api_key
TRELLO_API_TOKEN=your_trello_api_token
TRELLO_UPLOAD_ROOTS=/absolute/path/to/allowed/uploads
